+def _should_stream_quant_postprocess(
+    weight_load_plan: WeightLoadPlan, load_on_cpu: bool
+) -> bool:
+    enabled = os.environ.get("SGLANG_ONLINE_QUANT_STREAM_POSTPROCESS", "").lower()
